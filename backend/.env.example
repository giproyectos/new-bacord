DATABASE_URL="mysql://user:password@127.0.0.1:3306/bacord_poc"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="change-me"

# SMTP para correos de invitación / restablecimiento de contraseña.
# Si SMTP_HOST se deja vacío, los correos solo se registran en la consola del backend (no se envían).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BACord EBR <no-reply@bacord.local>"

# Inicio de sesión con proveedor externo (OIDC) — opcional. Si OIDC_ISSUER_URL se deja vacío,
# esta instancia solo ofrece el acceso local (usuario/clave); nada más cambia. Funciona con
# cualquier proveedor que cumpla el estándar OIDC — Microsoft Entra ID, Google, Okta, Auth0,
# Keycloak — sin código específico de ninguno: solo cambian estas variables.
# IMPORTANTE: nunca crea usuarios — la cuenta (con su Centro/Rol/Grupo Responsable) debe
# existir de antemano en Bacord, creada por un administrador desde el módulo Usuarios.
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:4000/api/auth/oidc/callback"
OIDC_SCOPES="openid email profile"
OIDC_LABEL="tu cuenta de Microsoft"
