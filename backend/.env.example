DATABASE_URL="mysql://user:password@127.0.0.1:3306/bacord_poc"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="change-me"

# SMTP para correos de invitación / restablecimiento de contraseña.
# Si SMTP_HOST se deja vacío, los correos solo se registran en la consola del backend (no se envían).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BACord EBR <no-reply@bacord.local>"
