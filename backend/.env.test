# Solo para `npm test` — nunca apuntar esta base a datos reales de un cliente.
# Crear la base de datos y el usuario una vez, en local:
#   CREATE DATABASE bacord_test CHARACTER SET utf8mb4;
#   CREATE USER 'bacord_test'@'127.0.0.1' IDENTIFIED BY 'bacord_test_pw';
#   GRANT ALL PRIVILEGES ON bacord_test.* TO 'bacord_test'@'127.0.0.1';
DATABASE_URL="mysql://bacord_test:bacord_test_pw@127.0.0.1:3306/bacord_test"
JWT_SECRET="test-secret-solo-para-pruebas-automatizadas-no-usar-en-otro-lado"
CORS_ORIGIN="http://localhost:5173"
PORT=4099
